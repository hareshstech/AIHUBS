# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign HTTP-only session cookies.
# Set a strong random 32+ character secret in production.
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"

# DB_PATH: Optional custom path to SQLite database file.
# Defaults to ./data/quadline.db
DB_PATH="./data/quadline.db"
